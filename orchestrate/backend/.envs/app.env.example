# Copy to app.env (git-ignored) and adjust:
#   cp orchestrate/backend/.envs/app.env.example orchestrate/backend/.envs/app.env
# Hosts `postgres` / `redis` are the shared containers on the `common-net` network.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Use a dedicated database for this app; create it once on the shared server, e.g.
#   docker exec common-postgres psql -U <user> -d postgres -c 'CREATE DATABASE pos_db'
DATABASE_URL=postgres://pos:pos@postgres:5432/pos_db

# Shared Redis: add the password and pick an unused logical DB, e.g. redis://:<password>@redis:6379/1
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_PROXY=1
API_DOCS=true
SEED_PASSWORD=REDACTED
