# Copy to app.env for docker compose: cp orchestrate/backend/.envs/app.env.example orchestrate/backend/.envs/app.env
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://pos:pos@postgres:5432/pos_db
REDIS_URL=redis://redis:6379
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=1
API_DOCS=true
SEED_PASSWORD=REDACTED
