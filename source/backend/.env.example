NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_db
DATABASE_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# Redis (token blacklist, rate limiting, menu cache). App degrades gracefully if unavailable.
REDIS_URL=redis://localhost:6379

# JWT. In production JWT_SECRET is required and must be >= 32 chars,
# unless RS256 key paths are provided (both files must exist).
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Comma-separated allowed browser origins. Empty = allow any origin (dev only).
CORS_ORIGINS=http://localhost:5173

# Set when running behind a reverse proxy / load balancer (number of hops), so rate limiting sees client IPs.
TRUST_PROXY=0

# Rate limits (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Swagger UI at /docs (default: enabled outside production)
API_DOCS=

# Seed
SEED_PASSWORD=REDACTED
